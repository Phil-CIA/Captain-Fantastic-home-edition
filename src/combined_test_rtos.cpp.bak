// ========== ONBOARD LED BLINK TASK FOR VERIFICATION ========== 

// ========== SHIFT REGISTER UPDATE SYSTEM ========== 
#include "freertos/semphr.h"

// Forward declaration for timer-driven matrix scan handler
void handleMatrixScanFromISR();
#define SR_DATA   2   // GPIO2 - Serial data (SER/DS pin on first 595)
#define SR_CLOCK  12  // GPIO12 - Shift clock (SRCLK/SH_CP on both 595s)
#define SR_LATCH  4   // GPIO4 - Storage register clock (RCLK/ST_CP on both 595s)

volatile uint16_t shiftRegisterState = 0;
volatile uint16_t shiftRegisterDesiredState = 0;
QueueHandle_t shiftRegRequestQueue;

void shiftOut16(uint16_t value) {
    digitalWrite(SR_LATCH, LOW);
    for (int i = 15; i >= 0; i--) {
        digitalWrite(SR_CLOCK, LOW);
        digitalWrite(SR_DATA, (value >> i) & 0x01);
        digitalWrite(SR_CLOCK, HIGH);
    }
    digitalWrite(SR_LATCH, HIGH);
    delayMicroseconds(5); // Allow latch to settle
}

void shiftRegisterUpdateTask(void *pvParameters) {
    pinMode(SR_DATA, OUTPUT);
    pinMode(SR_CLOCK, OUTPUT);
    pinMode(SR_LATCH, OUTPUT);
    uint16_t lastWritten = 0xFFFF;
    while (1) {
        if (shiftRegisterDesiredState != lastWritten) {
            shiftRegisterState = shiftRegisterDesiredState;
            shiftOut16(shiftRegisterState);
            lastWritten = shiftRegisterState;
            delayMicroseconds(200); // Allow hardware to settle
        }
        vTaskDelay(pdMS_TO_TICKS(1)); // Polling interval
    }
}

// Request structure for shift register updates
struct ShiftRegRequest {
    uint16_t value;
    bool orMask; // true: OR with current, false: set absolute
};

void requestShiftRegisterUpdate(uint16_t value, bool orMask = false) {
    ShiftRegRequest req = {value, orMask};
    xQueueSend(shiftRegRequestQueue, &req, pdMS_TO_TICKS(100));
}

// ========== SHIFT REGISTER WALKING 1 TEST TASK (USING SEMAPHORE SYSTEM) ========== 
// Forward declaration for test task
void updateShiftRegister();
void shiftRegisterTestTask(void *pvParameters) {
    const int ONBOARD_LED_PIN = 2; // GPIO2 is onboard LED for ESP32 DevKit
    pinMode(ONBOARD_LED_PIN, OUTPUT); // Onboard LED
    while (1) {
        for (int i = 0; i < 16; i++) {
            shiftRegisterState = (1 << i);
            updateShiftRegister();
            digitalWrite(ONBOARD_LED_PIN, (i % 2) ? HIGH : LOW); // Toggle onboard LED for visual feedback
            vTaskDelay(pdMS_TO_TICKS(250));
        }
    }
}

// ========== HARDWARE CONFIGURATION ==========

// LED 7-Segment Display (HT16K33 breakout - bare chip with 8 COM outputs)
// Testing all 8 positions (COM0-COM7) to find which 6 are wired to displays
#define HT16K33_ADDRESS 0x70  // Single HT16K33 breakout

// I2C Configuration - Bus 0 (HT16K33 Display)
#define I2C_SDA 21
#define I2C_SCL 22
#define I2C_FREQ 100000

// ========== SHIFT REGISTER CONFIGURATION (Two 74HC595s) ==========
// Two 74HC595 shift registers daisy-chained: 16 bits total
// Controls solenoids, lamp columns, and status LEDs
#define SR_DATA   2   // GPIO2 - Serial data (SER/DS pin on first 595)
#define SR_CLOCK  12  // GPIO12 - Shift clock (SRCLK/SH_CP on both 595s)
#define SR_LATCH  4   // GPIO4 - Storage register clock (RCLK/ST_CP on both 595s)

// Shift register bit mapping (16 bits total):
// U9 (First 595) - Bits 0-7:  Lamp columns + unused
// U1 (Second 595) - Bits 8-15: Solenoids + status LEDs

// U9 outputs (bits 0-7):
#define SR_BIT_L3   0  // Bit 0: Lamp column L3 (TILT lamp - not scanned)
#define SR_BIT_L4   1  // Bit 1: Lamp column L4 (matrix scan)
#define SR_BIT_L5   2  // Bit 2: Lamp column L5 (matrix scan)
#define SR_BIT_L6   3  // Bit 3: Lamp column L6 (matrix scan)
#define SR_BIT_L7   4  // Bit 4: Lamp column L7 (matrix scan)
#define SR_BIT_SOL0 5  // Bit 5: Solenoid 0
#define SR_BIT_SOL1 6  // Bit 6: Solenoid 1
#define SR_BIT_SOL2 7  // Bit 7: Solenoid 2

// U1 outputs (bits 8-15):
#define SR_BIT_SOL3 8   // Bit 8: Solenoid 3
#define SR_BIT_SOL4 9   // Bit 9: Solenoid 4
#define SR_BIT_SOL5 10  // Bit 10: Solenoid 5
#define SR_BIT_LED9 11  // Bit 11: Status LED9 (direct)
#define SR_BIT_LED10 12 // Bit 12: Status LED10 (direct)
// Bits 13-15: Unused

// ========== LAMP MATRIX CONFIGURATION ==========
// Lamp Matrix: 8 rows × 5 columns = 40 lamps (32 scanned + TILT)
// Row drivers: ESP32 GPIO → 2N7000/BSS138 → IRF4905 P-channel MOSFETs
// Column drivers: 74HC595 shift register → N-channel MOSFETs

// Row pins (M1-M8) - P-channel via N-ch level shifter (inverted: HIGH = ON)
#define ROW_M1  23  // GPIO23 (per spreadsheet)
#define ROW_M2  19  // GPIO19  
#define ROW_M3  18  // GPIO18
#define ROW_M4   5  // GPIO5
#define ROW_M5  17  // GPIO17
#define ROW_M6  16  // GPIO16
#define ROW_M7  15  // GPIO15
#define ROW_M8  13  // GPIO13

// Lamp columns now driven by shift register (see SR_BIT_L3-L7 above)
// GPIO 27, 26, 33, 32 freed up for SPI flash

#define NUM_LAMP_ROWS 8
#define NUM_LAMP_COLS 5  // L3(TILT) + L4 + L5 + L6 + L7
#define LAMP_REFRESH_RATE 200  // Hz (5ms per complete scan)

// ========== SWITCH MATRIX CONFIGURATION ==========
// Switch Matrix: 8 rows × 4 columns = 32 switch positions (22 used)
// Shares same 8 rows with lamp matrix
// Switch columns: Input-only GPIOs with internal pull-ups

// Switch column pins (SW1-SW4) - Input with pull-ups
#define COL_SW1  35  // GPIO35 (input-only)
#define COL_SW2  34  // GPIO34 (input-only)
#define COL_SW3  39  // GPIO39 (input-only)
#define COL_SW4  36  // GPIO36 (input-only)

#define NUM_SWITCH_ROWS 8
#define NUM_SWITCH_COLS 4
#define SWITCH_DEBOUNCE_MS 20  // Debounce time in milliseconds

// ========== TEST/DIAGNOSTIC SWITCH ==========
