{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Captain: Build (combined_rtos)",
			"detail": "Captain-Fantastic project build",
			"type": "shell",
			"command": "C:/Users/user/.platformio/penv/Scripts/platformio.exe",
			"args": [
				"run",
				"-e",
				"combined_rtos"
			],
			"problemMatcher": [
				"$platformio"
			],
			"group": "build"
		},
		{
			"label": "Captain: Upload (combined_rtos)",
			"detail": "Captain-Fantastic project upload",
			"type": "shell",
			"command": "C:/Users/user/.platformio/penv/Scripts/platformio.exe",
			"args": [
				"run",
				"-e",
				"combined_rtos",
				"-t",
				"upload"
			],
			"group": "build"
		},
		{
			"label": "Captain: Build (matrix guarded)",
			"detail": "Matrix build through guarded wrapper",
			"type": "shell",
			"command": "powershell",
