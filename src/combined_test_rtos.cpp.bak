// ========== EM-STYLE GAME STATE ==========
// Persistent game state (like EM relays/steppers)
struct GameState {
    uint8_t currentBall;        // 1-5
    uint8_t currentPlayer;      // 1-4
    uint8_t numPlayers;         // 1-4
    uint32_t playerScores[4];   // Individual scores
    uint8_t bonusValue;         // 0-10 (bonus ladder 1K-10K)
    uint8_t multiplier;         // 1, 2, 3, 5 (score multiplier)
    bool extraBallLit;          // Special relay state
    bool ballInPlay;            // Game active
    bool gameOver;              // Waiting for coin/start
    bool tiltActive;            // Tilt relay
    uint32_t ballStartTime;     // For timeout detection
} gameState;

// Initialize game state
void initGameState() {
    gameState.currentBall = 1;
    gameState.currentPlayer = 1;
    gameState.numPlayers = 1;
    for (int i = 0; i < 4; i++) {
        gameState.playerScores[i] = 0;
    }
    gameState.bonusValue = 0;
    gameState.multiplier = 1;
    gameState.extraBallLit = false;
    gameState.ballInPlay = false;
    gameState.gameOver = true;
    gameState.tiltActive = false;
    gameState.ballStartTime = 0;
    currentScore = 0;
}

